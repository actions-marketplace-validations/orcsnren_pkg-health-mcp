{
  "name": "pkg-health-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.orcsnren/pkg-health-mcp",
  "description": "Is this dependency still maintained? MCP server, CLI and GitHub Action that score npm packages, PyPI packages and GitHub repositories 0-100 for maintenance health, with an A-F grade and a list of risks.",
  "type": "module",
  "bin": {
    "pkg-health-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "cursor",
    "ai-agent",
    "dependencies",
    "dependency-health",
    "dependency-audit",
    "supply-chain",
    "supply-chain-security",
    "npm",
    "pypi",
    "github",
    "github-action",
    "lockfile",
    "maintenance",
    "abandoned",
    "deprecated",
    "bus-factor",
    "openssf",
    "scorecard",
    "ci",
    "cli"
  ],
  "author": "orcsnren",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orcsnren/pkg-health-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/orcsnren/pkg-health-mcp/issues"
  },
  "homepage": "https://github.com/orcsnren/pkg-health-mcp#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
