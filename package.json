{
  "name": "pkg-health-mcp",
  "version": "0.1.0",
  "description": "MCP server that scores the maintenance health of npm and PyPI packages, so AI agents (and humans) can spot abandoned dependencies.",
  "type": "module",
  "bin": {
    "pkg-health-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dependencies",
    "supply-chain",
    "npm",
    "pypi",
    "maintenance",
    "health",
    "openssf"
  ],
  "author": "orcsnren",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orcsnren/pkg-health-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/orcsnren/pkg-health-mcp/issues"
  },
  "homepage": "https://github.com/orcsnren/pkg-health-mcp#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
